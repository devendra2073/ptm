<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Balance & History</title>
    <style type="text/css" media="all">
      :root {
    --bg-color: #f5f9ff;
    --text-main: #1d252d;
    --text-sub: #6c757d;
    --bob-orange: linear-gradient(135deg, #e65100, #ff8f00);
    --hdfc-blue: linear-gradient(135deg, #003366, #004a99);
    --slice-purple: linear-gradient(135deg, #2b1055, #7597de);
}

body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background-color: var(--bg-color);
    color: var(--text-main);
}
.sml{
  height: 14px;
  aspect-ratio: 1/1;
  vertical-align: middle;
}
.app-container {
    max-width: 450px;
    margin: 0 auto;
    background: #fff;
    min-height: 100vh;
    padding-bottom: 20px;
}

/* Header */
.header {
    display: flex;
    align-items: center;
    padding: 15px;
    gap: 15px;
    border-bottom: 1px solid #f1f1f1;
}
.header h1 { font-size: 1.2rem; flex-grow: 1; margin: 0; }
.back-btn, .more-btn { font-size: 1.2rem; cursor: pointer; }

/* Bank Cards */
.accounts-section { padding: 15px; }
.accounts-section h2 { font-size: 1rem; color: var(--text-sub); margin-bottom: 15px; }
.cards-container { display: flex; gap: 12px; overflow-x: auto; padding-bottom: 10px; scrollbar-width: none; }
.cards-container::-webkit-scrollbar { display: none; }

.bank-card {
    min-width: 180px;
    border-radius: 16px;
    padding: 15px;
    color: white;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 110px;
    flex-shrink: 0;
}
.bob { background: var(--bob-orange); }
.hdfc { background: var(--hdfc-blue); }
.slice { background: var(--slice-purple); }

.card-header { display: flex; justify-content: space-between; align-items: flex-start; }
.bank-name { display: block; font-weight: bold; font-size: 1.1rem; }
.acc-no { font-size: 0.8rem; opacity: 0.9; }
.mdl{ height: 25px; width: 25px; border-radius: 50%; object-fit: cover; background: #fff; }

.check-balance {
    background: rgba(255, 255, 255, 0.9);
    border: none;
    padding: 6px 10px;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.8rem;
    color: #333;
    cursor: pointer;
    width: fit-content;
}

/* Portfolio Section */
.portfolio-section {
    padding: 0 15px 15px 15px;
}
.portfolio-section h2 { font-size: 1rem; color: var(--text-sub); margin-bottom: 10px; }
.portfolio-cards {
    display: flex;
    gap: 12px;
}
.portfolio-card {
    flex: 1;
    background: #fafafa;
    border: 1px solid #eee;
    border-radius: 14px;
    padding: 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.p-title { font-size: 0.8rem; color: var(--text-sub); display: block; }
.p-value { font-weight: bold; font-size: 1rem; margin-top: 4px; display: block; }
.gold-icon { font-size: 24px; }

/* History List */
.history-section { border-top: 8px solid #f5f9ff; }
.history-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px;
}
.history-header h2 { font-size: 1rem; margin: 0; }
.history-icons { display: flex; gap: 15px; font-size: 1.1rem; color: var(--text-sub); }

.month-summary {
    display: flex;
    justify-content: space-between;
    padding: 10px 15px;
    background: #fdfdfd;
    border-bottom: 1px solid #eee;
    font-size: 0.9rem;
    font-weight: 600;
}
.spent-box { text-align: right; }
.spent-label { display: block; font-size: 0.75rem; color: var(--text-sub); font-weight: normal; }
.spent-amount { color: #d32f2f; }

.transaction-item {
    display: flex;
    padding: 15px;
    border-bottom: 1px solid #f1f1f1;
    align-items: flex-start;
}

.avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #fff8e1;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 12px;
    font-weight: bold;
    color: #ffb300;
    font-size: 0.9rem;
    flex-shrink: 0;
}
.details { flex-grow: 1; }
.name { font-weight: 600; display: block; font-size: 0.95rem; }
.sub-text { font-size: 0.75rem; color: var(--text-sub); margin-top: 2px; display: block; }

.badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 20px;
    font-size: 0.7rem;
    background: #e8f5e9;
    color: #2e7d32;
    margin-top: 6px;
}
.badge.failed {
    background: #ffebee;
    color: #c62828;
}

.amount-col { text-align: right; flex-shrink: 0; }
.amount { font-weight: bold; font-size: 0.95rem; }
.amount.negative { color: #1d252d; }
.from-bank { font-size: 0.7rem; color: var(--text-sub); margin-top: 5px; }

.footer-brand {
    text-align: center;
    font-size: 0.75rem;
    color: #999;
    padding: 20px;
}
    </style>
</head>
<body>
    <div class="app-container">
        <header class="header">
            <div class="back-btn" onclick="history.back()">←</div>
            <h1>Balance & History</h1>
            <div class="more-btn">⋮</div>
        </header>

        <!-- Accounts Section -->
        <section class="accounts-section">
            <h2>Accounts</h2>
            <div class="cards-container">
                <div class="bank-card bob">
                    <div class="card-header">
                        <div class="bank-info">
                            <span class="bank-name">BOB Bank</span>
                            <span class="acc-no">Saving A/c: 0567</span>
                        </div>
                        <div class="bank-logo"><img src="./media/bob.png" class="mdl" onerror="this.src='https://via.placeholder.h/25'"></div>
                    </div>
                    <button class="check-balance" onclick="alert('Balance: ₹12,450')">Check Balance</button>
                </div>
                <div class="bank-card hdfc">
                    <div class="card-header">
                        <div class="bank-info">
                            <span class="bank-name">HDFC Bank</span>
                            <span class="acc-no">Saving A/c: 6813</span>
                        </div>
                        <div class="bank-logo"><img src="./media/hdfc.png" class="mdl" onerror="this.src='https://via.placeholder.com/25'"></div>
                    </div>
                    <button class="check-balance" onclick="alert('Balance: ₹45,200')">Check Balance</button>
                </div>
                <div class="bank-card slice">
                    <div class="card-header">
                        <div class="bank-info">
                            <span class="bank-name">Slice Small...</span>
                            <span class="acc-no">Saving A/c: 5571</span>
                        </div>
                        <div class="bank-logo"><img src="./media/slice.png" class="mdl" onerror="this.src='https://via.placeholder.com/25'"></div>
                    </div>
                    <button class="check-balance" onclick="alert('Balance: ₹3,100')">Check Balance</button>
                </div>
            </div>
        </section>

        <!-- Portfolio Section -->
        <section class="portfolio-section">
            <h2>Portfolio</h2>
            <div class="portfolio-cards">
                <div class="portfolio-card">
                    <div>
                        <span class="p-title">Gold Coins</span>
                        <span class="p-value">421</span>
                    </div>
                    <div class="gold-icon">🪙</div>
                </div>
                <div class="portfolio-card" style="background: linear-gradient(135deg, #fff9c4, #fff59d);">
                    <div>
                        <span class="p-title" style="color: #795548;">Save in Gold</span>
                        <span class="p-value" style="color: #5d4037; font-size: 0.9rem;">Invest Now →</span>
                    </div>
                    <div class="gold-icon">🥇</div>
                </div>
            </div>
        </section>

        <!-- History Section -->
        <section class="history-section">
            <div class="history-header">
                <h2>Payment History</h2>
                <div class="history-icons">
                    <span>🔍</span>
                    <span>≗</span>
                    <span>📥</span>
                </div>
            </div>

            <div class="month-summary">
                <span class="month-name">October 2026</span>
                <div class="spent-box">
                    <span class="spent-label">Total Spent</span>
                    <span class="spent-amount">₹629</span>
                </div>
            </div>

            <div id="transaction-list">
                <!-- Transactions will load dynamically via JS -->
            </div>
        </section>

        <footer class="footer-brand">
            Paytm <span>| Powered by UPI</span>
        </footer>
    </div>

    <script>
      // Default sample data mimicking your video recording if localStorage is empty
      const defaultHistory = [
          { name: "Devendra Nishad", date: "Yesterday, 09:16 PM", amount: "2", status: "success", type: "Miscellaneous", bank: "bob" },
          { name: "Sai Shopee", date: "20 Oct, 2023 11:21 AM", amount: "1,299", status: "failed", type: "Shopping", bank: "hdfc" },
          { name: "Navin Bros Lendplus1", date: "20 Oct, 2021 AM", amount: "123", status: "success", type: "Financial Services", bank: "slice" },
          { name: "Navin Bros Lendplus1", date: "19 Oct, 02:23 PM", amount: "500", status: "success", type: "Financial Services", bank: "bob" }
      ];

      const historyData = JSON.parse(localStorage.getItem('history')) || defaultHistory;
      const listContainer = document.getElementById('transaction-list');

      function renderHistory() {
          if (historyData.length === 0) {
              listContainer.innerHTML = '<p style="text-align:center; padding:20px; color:#6c757d;">No transactions found.</p>';
              return;
          }

          listContainer.innerHTML = historyData.map(item => {
              const initial = item.name ? item.name.charAt(0) : "U";
              const isFailed = item.status === 'failed';
              
              return `
                  <div class="transaction-item">
                      <div class="avatar">${initial}</div>
                      <div class="details">
                          <span class="name">${item.name}</span>
                          <span class="sub-text">${item.date}</span>
                          <div class="badge ${isFailed ? 'failed' : ''}">
                              ${isFailed ? '❌ Failed' : '🔄 ' + (item.type || 'Miscellaneous')}
                          </div>
                      </div>
                      <div class="amount-col">
                          <span class="amount negative">- ₹${item.amount}</span>
                          <div class="from-bank">From <img src="./media/${item.bank || 'bob'}.png" class="sml" onerror="this.src='https://via.placeholder.com/14'"></div>
                      </div>
                  </div>
              `;
          }).join('');
      }

      // Initialize
      renderHistory();
    </script>
</body>
</html>
