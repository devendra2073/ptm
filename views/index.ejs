        <div class="min-w-[140px] bg-rose-50/50 border border-rose-100 rounded-2xl p-3 flex flex-col justify-between cursor-pointer flex-shrink-0">
          <div>
            <span class="text-[11px] font-bold text-slate-800 leading-tight block mb-2">Track Your<br>Spends</span>
          </div>
          <div class="space-y-1 text-[10px] font-bold text-slate-600 my-1">
            <div class="flex justify-between bg-white px-1.5 py-0.5 rounded border">
              <span>🍔 Food</span> <span>₹4,600</span>
            </div>
            <div class="flex justify-between bg-white px-1.5 py-0.5 rounded border">
              <span>🛍️ Shopping</span> <span>₹9,589</span>
