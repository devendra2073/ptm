    </section>

    <!-- ================= DO MORE WITH PAYTM ================= -->
    <section class="paytm-card p-4">
      <h2 class="text-base font-bold text-slate-900 mb-4">Do More With Paytm</h2>

      <div class="grid grid-cols-4 gap-2 text-center mb-4">
        <div class="flex flex-col items-center cursor-pointer">
          <div class="w-11 h-11 rounded-2xl bg-blue-50 text-paytm-navy flex items-center justify-center text-lg mb-1.5">
            <i class="fa-solid fa-tags"></i>
          </div>
          <span class="text-[11px] font-medium text-slate-700 leading-tight">Claim<br>Deals</span>
        </div>

        <div class="flex flex-col items-center cursor-pointer">
          <div class="w-11 h-11 rounded-2xl bg-blue-50 text-paytm-navy flex items-center justify-center text-lg mb-1.5">
            <i class="fa-solid fa-gift"></i>
          </div>
          <span class="text-[11px] font-medium text-slate-700 leading-tight">Gift<br>Vouchers</span>
        </div>

        <div class="flex flex-col items-center cursor-pointer">
          <div class="w-11 h-11 rounded-2xl bg-blue-50 text-paytm-navy flex items-center justify-center text-lg mb-1.5">
            <i class="fa-solid fa-percent"></i>
          </div>
          <span class="text-[11px] font-medium text-slate-700 leading-tight">Cashback<br>& Offers</span>
        </div>

        <div class="flex flex-col items-center cursor-pointer">
          <div class="w-11 h-11 rounded-2xl bg-blue-50 text-paytm-navy flex items-center justify-center text-lg mb-1.5">
            <i class="fa-solid fa-border-all"></i>
          </div>
          <span class="text-[11px] font-medium text-slate-700 leading-tight">See All<br>Services</span>
        </div>
      </div>

      <!-- Play & Deals Tags -->
      <div class="grid grid-cols-2 gap-2">
        <div class="bg-slate-100 rounded-xl p-2 flex items-center gap-2 cursor-pointer">
          <i class="fa-brands fa-google-play text-emerald-600 text-sm"></i>
          <span class="text-[11px] font-semibold text-slate-800">Google Play | 5% Off</span>
        </div>
        <div class="bg-slate-100 rounded-xl p-2 flex items-center gap-2 cursor-pointer">
          <i class="fa-solid fa-[#e23744] fa-utensils text-rose-500 text-sm"></i>
          <span class="text-[11px] font-semibold text-slate-800">Deals Near You | 50% OF</span>
        </div>
      </div>
