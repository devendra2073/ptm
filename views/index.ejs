  </main>

  <!-- ================= FLOATING BOTTOM SCAN QR BUTTON ================= -->
  <div class="fixed bottom-4 left-1/2 -translate-x-1/2 z-50">
    <button onclick="triggerScanModal()" class="scan-btn text-white font-bold text-sm px-6 py-3 rounded-full flex items-center gap-2.5 shadow-2xl relative overflow-hidden group">
      <!-- Animated Radar Line -->
      <span class="scan-line"></span>

      <!-- QR Icon with outline -->
      <div class="w-6 h-6 border-2 border-white rounded flex items-center justify-center text-xs relative">
        <i class="fa-solid fa-qrcode"></i>
      </div>
      <span>Scan QR</span>
    </button>
  </div>

  <!-- ================= MODAL / ACTION DIALOG ================= -->
  <div id="actionModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl p-6 w-full max-w-xs text-center space-y-4 shadow-2xl transform transition-all scale-95 opacity-0 duration-200" id="modalContent">
      <div class="w-16 h-16 bg-blue-100 text-paytm-navy rounded-full flex items-center justify-center text-2xl mx-auto" id="modalIcon">
        <i class="fa-solid fa-check"></i>
      </div>
      <h3 class="text-lg font-bold text-slate-900" id="modalTitle">Action Triggered</h3>
      <p class="text-xs text-slate-500 leading-relaxed" id="modalBody">You tapped on an interactive Paytm feature.</p>
      <button onclick="closeModal()" class="w-full bg-paytm-navy text-white font-bold text-sm py-2.5 rounded-xl hover:bg-blue-950 transition-colors">
        Dismiss
      </button>
    </div>
  </div>

  <!-- ================= JAVASCRIPT ================= -->
  <script>
    function triggerAction(name) {
      const modal = document.getElementById('actionModal');
      const modalContent = document.getElementById('modalContent');
      const modalTitle = document.getElementById('modalTitle');
      const modalBody = document.getElementById('modalBody');
      const modalIcon = document.getElementById('modalIcon');

      modalTitle.innerText = name;
      modalBody.innerText = `Redirecting to ${name} page...`;
      modalIcon.innerHTML = `<i class="fa-solid fa-bolt"></i>`;

      modal.classList.remove('hidden');
      setTimeout(() => {
        modalContent.classList.remove('scale-95', 'opacity-0');
        modalContent.classList.add('scale-100', 'opacity-100');
      }, 10);
    }

    function triggerPay(service, amount) {
      const modal = document.getElementById('actionModal');
      const modalContent = document.getElementById('modalContent');
      const modalTitle = document.getElementById('modalTitle');
      modalTitle.innerText = `Pay ${service}`;
      document.getElementById('modalBody').innerText = `Proceeding to pay ₹${amount.toLocaleString('en-IN')} via Paytm UPI.`;
      document.getElementById('modalIcon').innerHTML = `<i class="fa-solid fa-indian-rupee-sign"></i>`;

      modal.classList.remove('hidden');
      setTimeout(() => {
        modalContent.classList.remove('scale-95', 'opacity-0');
        modalContent.classList.add('scale-100', 'opacity-100');
      }, 10);
    }

    function triggerScanModal() {
      triggerAction('Camera QR Scanner');
    }

    function closeModal() {
      const modal = document.getElementById('actionModal');
      const modalContent = document.getElementById('modalContent');

      modalContent.classList.remove('scale-100', 'opacity-100');
      modalContent.classList.add('scale-95', 'opacity-0');
      setTimeout(() => {
        modal.classList.add('hidden');
      }, 200);
    }
  </script>
</body>
</html>
