        <!-- Tool Card 4: IRCTC Status -->
        <div class="min-w-[140px] bg-blue-50/50 border border-blue-100 rounded-2xl p-3 flex flex-col justify-between cursor-pointer flex-shrink-0">
          <div>
            <span class="text-[11px] font-bold text-slate-800 leading-tight block mb-2">IRCTC<br>Status</span>
          </div>
          <div class="flex justify-center my-1 text-2xl text-paytm-blue">
            <i class="fa-solid fa-train"></i>
